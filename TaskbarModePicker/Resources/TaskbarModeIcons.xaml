<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- All: both displays show a taskbar. -->
    <DataTemplate x:Key="AllModeIconTemplate">
        <Canvas Width="68" Height="42" IsHitTestVisible="False">
            <Rectangle Canvas.Left="4" Canvas.Top="3" Width="26" Height="20"
                       Fill="Transparent" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Rectangle Canvas.Left="38" Canvas.Top="3" Width="26" Height="20"
                       Fill="Transparent" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />

            <Line X1="17" Y1="24" X2="17" Y2="29" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Line X1="51" Y1="24" X2="51" Y2="29" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Line X1="13" Y1="31" X2="21" Y2="31" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Line X1="47" Y1="31" X2="55" Y2="31" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />

            <Rectangle Canvas.Left="7" Canvas.Top="19" Width="20" Height="2"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="1" RadiusY="1" />
            <Rectangle Canvas.Left="41" Canvas.Top="19" Width="20" Height="2"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="1" RadiusY="1" />
        </Canvas>
    </DataTemplate>

    <!-- MainAndWindow: the main display is always included; the second follows the window. -->
    <DataTemplate x:Key="MainAndWindowModeIconTemplate">
        <Canvas Width="68" Height="42" IsHitTestVisible="False">
            <Rectangle Canvas.Left="4" Canvas.Top="3" Width="26" Height="20"
                       Fill="Transparent" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Rectangle Canvas.Left="38" Canvas.Top="3" Width="26" Height="20"
                       Fill="Transparent" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />

            <Line X1="17" Y1="24" X2="17" Y2="29" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Line X1="51" Y1="24" X2="51" Y2="29" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Line X1="13" Y1="31" X2="21" Y2="31" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Line X1="47" Y1="31" X2="55" Y2="31" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />

            <Rectangle Canvas.Left="7" Canvas.Top="19" Width="20" Height="2"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="1" RadiusY="1" />
            <Rectangle Canvas.Left="41" Canvas.Top="19" Width="20" Height="2"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.55" RadiusX="1" RadiusY="1" />
            <Rectangle Canvas.Left="45" Canvas.Top="8" Width="10" Height="7"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.75" RadiusX="1" RadiusY="1" />
        </Canvas>
    </DataTemplate>

    <!-- Window: only the display containing the window shows a taskbar. -->
    <DataTemplate x:Key="WindowModeIconTemplate">
        <Canvas Width="68" Height="42" IsHitTestVisible="False">
            <Rectangle Canvas.Left="4" Canvas.Top="3" Width="26" Height="20"
                       Fill="Transparent" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Rectangle Canvas.Left="38" Canvas.Top="3" Width="26" Height="20"
                       Fill="Transparent" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />

            <Line X1="17" Y1="24" X2="17" Y2="29" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Line X1="51" Y1="24" X2="51" Y2="29" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Line X1="13" Y1="31" X2="21" Y2="31" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />
            <Line X1="47" Y1="31" X2="55" Y2="31" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" />

            <Rectangle Canvas.Left="41" Canvas.Top="19" Width="20" Height="2"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="1" RadiusY="1" />
            <Rectangle Canvas.Left="45" Canvas.Top="8" Width="10" Height="7"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.75" RadiusX="1" RadiusY="1" />
        </Canvas>
    </DataTemplate>
</ResourceDictionary>
