<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaskbarModePicker.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="SelectedModeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModeButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Border
            Padding="18,8,18,12"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            CornerRadius="14">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Görev çubuğu modu"
                        FontSize="16"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <Button
                        x:Name="PopupCloseButton"
                        Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTipService.ToolTip="Kapat (Esc)"
                        AutomationProperties.Name="Kapat"
                        Click="CloseButton_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="6" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="AllModeButton"
                        Tag="All"
                        Grid.Column="0"
                        Height="176"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Style="{StaticResource ModeButtonStyle}"
                        AutomationProperties.Name="Tüm görev çubukları"
                        ToolTipService.ToolTip="Tüm görev çubukları"
                        Click="ModeButton_Click">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Canvas Grid.Row="0" Width="68" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M4,3 H30 V23 H4 Z M38,3 H64 V23 H38 Z M17,24 V29 M51,24 V29 M13,31 H21 M47,31 H55"
                                      Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                <Rectangle Canvas.Left="7" Canvas.Top="19" Width="20" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <Rectangle Canvas.Left="41" Canvas.Top="19" Width="20" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Canvas>
                            <TextBlock Grid.Row="1" Text="Tüm görev çubukları" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxLines="3" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="MainAndWindowModeButton"
                        Tag="MainAndWindow"
                        Grid.Column="1"
                        Height="176"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Style="{StaticResource ModeButtonStyle}"
                        AutomationProperties.Name="Ana görev çubuğu ve pencerenin açıldığı görev çubuğu"
                        ToolTipService.ToolTip="Ana görev çubuğu ve pencerenin açıldığı görev çubuğu"
                        Click="ModeButton_Click">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Canvas Grid.Row="0" Width="68" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M4,3 H30 V23 H4 Z M38,3 H64 V23 H38 Z M17,24 V29 M51,24 V29 M13,31 H21 M47,31 H55"
                                      Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                <Rectangle Canvas.Left="7" Canvas.Top="19" Width="20" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <Rectangle Canvas.Left="41" Canvas.Top="19" Width="20" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.55" />
                                <Rectangle Canvas.Left="45" Canvas.Top="8" Width="10" Height="7" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.75" />
                            </Canvas>
                            <TextBlock Grid.Row="1" Text="Ana görev çubuğu ve pencerenin açıldığı görev çubuğu" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxLines="4" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="WindowModeButton"
                        Tag="Window"
                        Grid.Column="2"
                        Height="176"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Style="{StaticResource ModeButtonStyle}"
                        AutomationProperties.Name="Pencerenin açıldığı görev çubuğu"
                        ToolTipService.ToolTip="Pencerenin açıldığı görev çubuğu"
                        Click="ModeButton_Click">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Canvas Grid.Row="0" Width="68" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M4,3 H30 V23 H4 Z M38,3 H64 V23 H38 Z M17,24 V29 M51,24 V29 M13,31 H21 M47,31 H55"
                                      Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                <Rectangle Canvas.Left="41" Canvas.Top="19" Width="20" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <Rectangle Canvas.Left="45" Canvas.Top="8" Width="10" Height="7" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.75" />
                            </Canvas>
                            <TextBlock Grid.Row="1" Text="Pencerenin açıldığı görev çubuğu" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxLines="3" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </Button>
                </Grid>

                <TextBlock
                    x:Name="StatusText"
                    Grid.Row="1"
                    Margin="8,0,8,0"
                    FontSize="11"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
