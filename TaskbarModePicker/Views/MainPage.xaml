<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaskbarModePicker.Views.MainPage"
    IsTabStop="True"
    KeyDown="MainPage_KeyDown"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
        </Style>

        <Style x:Key="SelectedModeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModeButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Border
            Padding="18,8,18,12"
            Background="Transparent"
            CornerRadius="14">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Uid="MainPage_Title"
                        FontSize="16"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <Button
                        x:Name="CloseButton"
                        x:Uid="MainPage_CloseButton"
                        Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        IsEnabled="{Binding CanInteract, Mode=OneWay}"
                        Click="CloseButton_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="6" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="AllModeButton"
                        x:Uid="MainPage_AllModeButton"
                        Tag="All"
                        Grid.Column="0"
                        Height="176"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Style="{StaticResource ModeButtonStyle}"
                        IsEnabled="{Binding CanInteract, Mode=OneWay}"
                        Click="ModeButton_Click">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="1" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <ContentControl Grid.Row="0" Content="Icon" ContentTemplate="{StaticResource AllModeIconTemplate}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw" />
                            <Grid Grid.Row="1" RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ProgressRing x:Name="AllModeProgressRing" Width="14" Height="14" IsActive="False"
                                              Visibility="Collapsed" HorizontalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Uid="MainPage_AllModeLabel" Grid.Row="1" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxLines="3" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Grid>
                    </Button>

                    <Button
                        x:Name="MainAndWindowModeButton"
                        x:Uid="MainPage_MainAndWindowModeButton"
                        Tag="MainAndWindow"
                        Grid.Column="1"
                        Height="176"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Style="{StaticResource ModeButtonStyle}"
                        IsEnabled="{Binding CanInteract, Mode=OneWay}"
                        Click="ModeButton_Click">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="2" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <ContentControl Grid.Row="0" Content="Icon" ContentTemplate="{StaticResource MainAndWindowModeIconTemplate}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw" />
                            <Grid Grid.Row="1" RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ProgressRing x:Name="MainAndWindowModeProgressRing" Width="14" Height="14" IsActive="False"
                                              Visibility="Collapsed" HorizontalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Uid="MainPage_MainAndWindowModeLabel" Grid.Row="1" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxLines="4" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Grid>
                    </Button>

                    <Button
                        x:Name="WindowModeButton"
                        x:Uid="MainPage_WindowModeButton"
                        Tag="Window"
                        Grid.Column="2"
                        Height="176"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Style="{StaticResource ModeButtonStyle}"
                        IsEnabled="{Binding CanInteract, Mode=OneWay}"
                        Click="ModeButton_Click">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="3" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <ContentControl Grid.Row="0" Content="Icon" ContentTemplate="{StaticResource WindowModeIconTemplate}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw" />
                            <Grid Grid.Row="1" RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ProgressRing x:Name="WindowModeProgressRing" Width="14" Height="14" IsActive="False"
                                              Visibility="Collapsed" HorizontalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Uid="MainPage_WindowModeLabel" Grid.Row="1" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxLines="3" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Grid>
                    </Button>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Text="{Binding StatusMessage, Mode=OneWay}"
                    Margin="8,0,8,0"
                    FontSize="11"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding StatusVisibility, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
